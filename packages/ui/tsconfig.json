{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*", "tailwind-preset.js"],
  "exclude": ["node_modules"]
}
